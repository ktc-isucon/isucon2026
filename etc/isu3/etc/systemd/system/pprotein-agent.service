[Unit]
Description=pprotein-agent
After=network-online.target
Wants=network-online.target

[Service]
User=isucon
Group=isucon
WorkingDirectory=/home/isucon
Environment=PORT=19000
Environment=PPROTEIN_SLOWLOG=/var/log/postgresql/postgresql-slow-mysql.log
Environment=PPROTEIN_GIT_REPOSITORY=/home/isucon
ExecStart=/home/isucon/go/bin/pprotein-agent
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
